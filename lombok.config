# Lombok Configuration for Advanced Accounting Project

# Enable annotation processing
lombok.addLombokGeneratedAnnotation = true

# Log Lombok processing (optional, for debugging)
# lombok.log.level = INFO

# Builder configuration
lombok.builder.className = *Builder

# Accessors configuration
lombok.accessors.fluent = false
lombok.accessors.chain = false

# ToString configuration
lombok.toString.callSuper = call

# EqualsAndHashCode configuration
lombok.equalsAndHashCode.callSuper = call

# Enable experimental features if needed
# lombok.experimental.flagUsage = warning
